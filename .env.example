PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=15m
TOKEN_REFRESH_EXPIRE_TIME=7d

POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=password123123
POSTGRES_DB=postgers_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres_user:password123123@db:5432/postgers_db?schema=public&connection_limit=10

LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

# NOTICE: SHOULD BE UNSET AT ALL TIMES, EXCEPT WHEN CHECKING RATE LIMITING, AUTO-TESTS WILL GENERATE A LOT OF TRAFFIC AND FAIL
# RATE_LIMIT_WINDOW_MS=5000
# RATE_LIMIT_THRESHOLD=2
# NOTICE: SHOULD BE UNSET AT ALL TIMES, EXCEPT WHEN CHECKING RATE LIMITING, AUTO-TESTS WILL GENERATE A LOT OF TRAFFIC AND FAIL

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.1-flash-lite-preview
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=3600
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RAG_VECTOR_DB_PROVIDER=qdrant
RAG_VECTOR_DB_URL=http://vectordb:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_CONVERSATION_MAX_MESSAGES=20
